---
import "@fontsource-variable/onest";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import ImageLightbox from "@/components/ImageLightbox.astro";
import { defaultLang, languages, type Lang } from "@/i18n/ui";
import {
  getLangFromUrl,
  localizePath,
  stripLangFromPath,
  useTranslations,
} from "@/i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  description = t("meta.description"),
  title = t("meta.title"),
  image = "/profile_picture.jpeg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Ensure the image URL is absolute with the full domain
const socialImageURL = new URL(image, Astro.site).toString();

// Versiones alternativas de ESTA misma página, para que Google entienda que
// son el mismo contenido en distintos idiomas y no las trate como duplicados.
const basePath = stripLangFromPath(Astro.url.pathname);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(localizePath(basePath, code), Astro.site).toString(),
}));
const defaultAlternate = alternates.find(({ code }) => code === defaultLang)!;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Idiomas alternativos -->
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />

    <!--
      Autodetección de idioma. Corre inline y antes del paint para evitar que
      se vea el idioma equivocado. Sólo actúa en rutas que existen en ambos
      idiomas y nunca pisa una elección explícita del usuario.
    -->
    <script is:inline>
      (function () {
        var SUPPORTED = ["en", "es"];
        var DEFAULT = "en";
        var STORAGE_KEY = "preferred-lang";
        var LOCALIZED_ROUTES = ["/"];

        var segments = window.location.pathname.split("/");
        var hasPrefix = SUPPORTED.indexOf(segments[1]) !== -1;
        var current = hasPrefix ? segments[1] : DEFAULT;

        var basePath = hasPrefix ? "/" + segments.slice(2).join("/") : window.location.pathname;
        if (basePath.length > 1 && basePath.charAt(basePath.length - 1) === "/") {
          basePath = basePath.slice(0, -1);
        }

        // Sólo redirigimos donde existe traducción.
        if (LOCALIZED_ROUTES.indexOf(basePath) === -1) return;

        var stored = null;
        try {
          stored = window.localStorage.getItem(STORAGE_KEY);
        } catch (error) {
          /* modo privado o storage bloqueado: seguimos con la detección */
        }

        var wanted;
        if (SUPPORTED.indexOf(stored) !== -1) {
          wanted = stored;
        } else {
          var navigatorLang =
            (window.navigator.languages && window.navigator.languages[0]) ||
            window.navigator.language ||
            DEFAULT;
          wanted = navigatorLang.toLowerCase().split("-")[0];
        }

        if (SUPPORTED.indexOf(wanted) === -1) wanted = DEFAULT;
        if (wanted === current) return;

        var target = (wanted === DEFAULT ? "" : "/" + wanted) + basePath;
        if (target === "") target = "/";
        if (target === window.location.pathname) return;

        window.location.replace(target + window.location.search + window.location.hash);
      })();
    </script>

    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="image" content={socialImageURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content={lang} />
    {
      alternates
        .filter(({ code }) => code !== lang)
        .map(({ code }) => <meta property="og:locale:alternate" content={code} />)
    }

    <!-- Fallbacks that some apps use -->
    <link rel="image_src" href={socialImageURL} />
    <meta name="thumbnail" content={socialImageURL} />
    <meta itemprop="image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- WhatsApp specific -->
    <meta name="theme-color" content="#ffffff" />

    <ViewTransitions />
  </head>

  <body class="relative text-black dark:text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(217,216,255,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <ImageLightbox />
    <style is:global>
      :root {
        color-scheme: light dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(255, 255, 255, 0.9);
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      @media (prefers-color-scheme: dark) {
        @keyframes blur {
          from {
            border: 0px;
          }
          to {
            box-shadow:
              0px 5px 50px -5px rgba(0, 0, 0, 0.1),
              0px 0px 0 1px rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(20px);
            border-width: 1px;
            border-color: rgba(0, 0, 0);
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 9999px;
          }
        }
      }
    </style>
  </body>
</html>
